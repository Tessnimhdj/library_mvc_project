# Deny all direct web access to uploaded files.
# منع الوصول المباشر إلى كل الملفات المرفوعة
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

# Turn the PHP engine off when mod_php is loaded.
# إيقاف محرك PHP عند تحميل الوحدة
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

# Do not execute uploaded PHP files.
# عدم تنفيذ ملفات PHP المرفوعة
RemoveHandler .php .phtml
RemoveType .php .phtml
